{
    "name": "pl_utl_get_databricks_account_access_token",
    "properties": {
        "activities": [
            {
                "name": "w_get_access_token",
                "type": "WebActivity",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "url": {
                        "value": "@{pipeline().globalParameters.gb_databricks_account_url}/oidc/accounts/@{pipeline().globalParameters.gp_databricks_account_id}/v1/token",
                        "type": "Expression"
                    },
                    "connectVia": {
                        "referenceName": "azir-mvn-nest-dp-uks-01",
                        "type": "IntegrationRuntimeReference"
                    },
                    "body": {
                        "value": "grant_type=client_credentials&scope=all-apis",
                        "type": "Expression"
                    },
                    "authentication": {
                        "type": "Basic",
                        "username": {
                            "value": "@pipeline().globalParameters.gp_databricks_client_id",
                            "type": "Expression"
                        },
                        "password": {
                            "type": "AzureKeyVaultSecret",
                            "store": {
                                "referenceName": "LS_KEYVAULT_MGT",
                                "type": "LinkedServiceReference"
                            },
                            "secretName": "app-nest-dp-databricks-devops-secret"
                        }
                    }
                }
            },
            {
                "name": "sv_pipeline_return",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "w_get_access_token",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "pipelineReturnValue",
                    "value": [
                        {
                            "key": "access_token",
                            "value": {
                                "type": "Expression",
                                "content": "@activity('w_get_access_token').output.access_token"
                            }
                        }
                    ],
                    "setSystemVariable": true
                }
            }
        ],
        "variables": {
            "job_id": {
                "type": "Integer"
            }
        },
        "folder": {
            "name": "PL_99_Utils"
        },
        "annotations": [],
        "lastPublishTime": "2025-12-04T15:30:38Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}