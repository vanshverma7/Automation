                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_utl_databricks_get_job_id",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "p_job_name": {
                            "value": "@pipeline().parameters.p_job_name",
                            "type": "Expression"
                        },
                        "p_access_token": {
                            "value": "@activity('pl_get_databricks_workspace_access_token').output.pipelineReturnValue.access_token",
                            "type": "Expression"
                        }
                    }
                }
            }
        ],
        "parameters": {
            "p_job_name": {
                "type": "string"
            }
        },
        "variables": {
            "v_access_token": {
                "type": "String"
            },
            "job_id": {
                "type": "Integer"
            }
        },
        "folder": {
            "name": "PL_99_Utils"
        },
