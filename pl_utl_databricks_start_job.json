                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "method": "POST",
                    "headers": {
                        "Authorization": {
                            "value": "Bearer @{activity('pl_get_databricks_workspace_access_token').output.pipelineReturnValue.access_token}",
                            "type": "Expression"
                        }
                    },
                    "url": {
                        "value": "@{pipeline().globalParameters.gp_databricks_workspace_url}/api/2.1/jobs/run-now",
                        "type": "Expression"
                    },
                    "connectVia": {
                        "referenceName": "azir-mvn-nest-dp-uks-01",
                        "type": "IntegrationRuntimeReference"
                    },
                    "body": {
                        "value": "{\n  \"job_id\": @{activity('pl_utl_databricks_get_job_id').output.pipelineReturnValue.job_id}\n}",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "pl_get_databricks_workspace_access_token",
                "type": "ExecutePipeline",
                "dependsOn": [],
                "policy": {
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_utl_get_databricks_workspace_access_token",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true
                }
            },
            {
                "name": "pl_utl_databricks_get_job_id",
                "type": "ExecutePipeline",
